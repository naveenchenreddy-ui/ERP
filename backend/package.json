{
  "name": "erp-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "ERP backend - Enquiry to Dispatch workflow for a manufacturing & supply company",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
