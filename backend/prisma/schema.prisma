// ERP Schema — Customer Enquiry → Quotation → Sales Order → Inventory Reservation → Dispatch

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── ENUMS ───────────────────────────

enum Role {
  ADMIN
  SALES_USER
}

enum EnquiryStatus {
  NEW
  QUOTED
  WON
  LOST
}

enum QuotationStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  DISPATCHED
  CANCELLED
}

enum InventoryAction {
  RESERVE
  RELEASE
  DISPATCH
}

enum Unit {
  pieces
  kg
  liters
  meters
  boxes
  rolls
  sets
}

// ─────────────────────────── MODELS ───────────────────────────

/// Users with roles: ADMIN or SALES_USER
model User {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  role         Role     @default(SALES_USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customers      Customer[]      @relation("UserCustomers")
  enquiries      Enquiry[]       @relation("UserEnquiries")
  quotations     Quotation[]     @relation("UserQuotations")
  orders         SalesOrder[]    @relation("SalesOrderCreatedBy")
  confirmedOrders SalesOrder[]   @relation("SalesOrderConfirmedBy")
  dispatches     Dispatch[]      @relation("UserDispatches")
  inventoryAudit InventoryAuditLog[] @relation("UserInventoryAudit")
  inventory      Inventory[]     @relation("UserInventory")

  @@map("users")
}

model Customer {
  id            Int      @id @default(autoincrement())
  companyName   String   @unique
  contactPerson String
  mobile        String
  email         String?
  city          String?
  createdById   Int
  createdBy     User     @relation("UserCustomers", fields: [createdById], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enquiries  Enquiry[]
  quotations Quotation[] @relation("CustomerQuotations")
  salesOrder SalesOrder[] @relation("CustomerOrders")

  @@map("customers")
}

model Product {
  id          Int      @id @default(autoincrement())
  productCode String   @unique
  productName String
  category    String?
  unit        Unit     @default(pieces)
  basePrice   Decimal  @default(0) @db.Decimal(12, 2)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  inventory          Inventory?
  enquiryItems       EnquiryItem[]
  quotationItems     QuotationItem[]
  salesOrderItems    SalesOrderItem[]
  dispatchItems      DispatchItem[]
  inventoryAuditLogs InventoryAuditLog[]

  @@map("products")
}

model Inventory {
  id               Int      @id @default(autoincrement())
  productId        Int      @unique
  product          Product  @relation(fields: [productId], references: [id])
  physicalQuantity Int      @default(0)
  reservedQuantity Int      @default(0)
  lastUpdated      DateTime @default(now())
  updatedById      Int?
  updatedBy        User?    @relation("UserInventory", fields: [updatedById], references: [id])

  @@map("inventory")
}

model Enquiry {
  id            Int           @id @default(autoincrement())
  enquiryNumber String        @unique
  customerId    Int
  customer      Customer      @relation(fields: [customerId], references: [id])
  enquiryDate   DateTime      @db.Date
  requiredDate  DateTime?     @db.Date
  status        EnquiryStatus @default(NEW)
  createdById   Int
  createdBy     User          @relation("UserEnquiries", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime @updatedAt

  items     EnquiryItem[]
  quotation Quotation?

  @@map("enquiries")
}

model EnquiryItem {
  id         Int     @id @default(autoincrement())
  enquiryId  Int
  enquiry    Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  productId  Int
  product    Product @relation(fields: [productId], references: [id])
  quantity   Int
  notes      String?
  createdAt  DateTime @default(now())

  @@map("enquiry_items")
}

model Quotation {
  id              Int              @id @default(autoincrement())
  quotationNumber String           @unique
  enquiryId       Int              @unique
  enquiry         Enquiry          @relation(fields: [enquiryId], references: [id])
  customerId      Int
  customer        Customer         @relation("CustomerQuotations", fields: [customerId], references: [id])
  quotationDate   DateTime         @db.Date
  validUntil      DateTime?        @db.Date
  status          QuotationStatus  @default(DRAFT)
  totalAmount     Decimal          @default(0) @db.Decimal(12, 2)
  gstAmount       Decimal          @default(0) @db.Decimal(12, 2)
  discountAmount  Decimal          @default(0) @db.Decimal(12, 2)
  createdById     Int
  createdBy       User             @relation("UserQuotations", fields: [createdById], references: [id])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  order      SalesOrder?         @relation("QuotationOrder")
  itemsList  QuotationItem[]

  @@map("quotations")
}

model QuotationItem {
  id              Int       @id @default(autoincrement())
  quotationId     Int
  quotation       Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId       Int
  product         Product   @relation(fields: [productId], references: [id])
  quantity        Int
  unitPrice       Decimal   @db.Decimal(12, 2)
  discountPercent Decimal   @default(0) @db.Decimal(5, 2)
  gstPercent      Decimal   @default(18) @db.Decimal(5, 2)
  lineAmount      Decimal   @default(0) @db.Decimal(12, 2)
  createdAt       DateTime  @default(now())

  @@map("quotation_items")
}

model SalesOrder {
  id            Int         @id @default(autoincrement())
  orderNumber   String      @unique
  quotationId   Int         @unique
  quotation     Quotation   @relation("QuotationOrder", fields: [quotationId], references: [id], onDelete: Restrict)
  customerId    Int
  customer      Customer    @relation("CustomerOrders", fields: [customerId], references: [id])
  orderDate     DateTime    @db.Date
  totalAmount   Decimal     @db.Decimal(12, 2)
  status        OrderStatus @default(PENDING)
  confirmedById Int?
  confirmedBy   User?       @relation("SalesOrderConfirmedBy", fields: [confirmedById], references: [id])
  confirmedAt   DateTime?
  createdById   Int
  createdBy     User        @relation("SalesOrderCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  items      SalesOrderItem[]
  dispatches Dispatch[]

  @@map("sales_orders")
}

model SalesOrderItem {
  id            Int        @id @default(autoincrement())
  salesOrderId  Int
  salesOrder    SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product    @relation(fields: [productId], references: [id])
  quantity      Int
  unitPrice     Decimal    @db.Decimal(12, 2)
  createdAt     DateTime   @default(now())

  @@map("sales_order_items")
}

model Dispatch {
  id            Int       @id @default(autoincrement())
  dispatchNumber String   @unique
  salesOrderId  Int
  salesOrder    SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Restrict)
  dispatchDate  DateTime  @db.Date
  vehicleNumber String?
  driverName    String?
  createdById   Int
  createdBy     User      @relation("UserDispatches", fields: [createdById], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  items DispatchItem[]

  @@map("dispatches")
}

model DispatchItem {
  id                Int      @id @default(autoincrement())
  dispatchId        Int
  dispatch          Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  productId         Int
  product           Product  @relation(fields: [productId], references: [id])
  quantityDispatched Int

  @@map("dispatch_items")
}

model InventoryAuditLog {
  id              Int             @id @default(autoincrement())
  productId       Int
  product         Product         @relation(fields: [productId], references: [id])
  action          InventoryAction
  quantityChanged Int
  referenceId     String?
  createdById     Int?
  createdBy       User?           @relation("UserInventoryAudit", fields: [createdById], references: [id])
  createdAt       DateTime        @default(now())

  @@map("inventory_audit_log")
}
